    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AppConfig>..\..\src\sip-testing-tool\App.config</AppConfig>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\sip-core\sip-core.csproj" />
    <ProjectReference Include="..\..\src\sip-console\sip-console.csproj" />
    <ProjectReference Include="..\..\src\sip-testing-tool\sip-testing-tool.csproj" />
  </ItemGroup>
</Project>
