<Project DefaultTargets="VerifyPublishPaths">
  <PropertyGroup>
    <PublishPathsFile>$([MSBuild]::GetPathOfFileAbove('PublishPaths.props', '$(MSBuildThisFileDirectory)'))</PublishPathsFile>
    <RepositoryDirectory>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetDirectoryName('$(PublishPathsFile)'))))</RepositoryDirectory>
  </PropertyGroup>
  <!-- Let each profile load its own path properties, as an independent publishing helper would. -->
  <Import Project="$(ProfileFile)" Condition="'$(ProfileFile)' != ''" />
  <Import Project="$(RepositoryDirectory)src/sip-testing-tool-avalonia/Properties/Velopack.targets" Condition="'$(ProfileFile)' != ''" />

  <UsingTask TaskName="VerifyPublishProfileStream" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ProfileFile ParameterType="System.String" Required="true" />
      <ApplicationProjectDirectory ParameterType="System.String" Required="true" />
      <ExpectedPublishPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Xml" />
      <Code Type="Method" Language="cs"><![CDATA[
      public override bool Execute()
      {
        try
        {
          // Use the running MSBuild assembly with either the .NET or Visual Studio host.
          var projectType = Type.GetType("Microsoft.Build.Evaluation.Project, Microsoft.Build", true);
          var collection = Activator.CreateInstance(projectType.Assembly.GetType("Microsoft.Build.Evaluation.ProjectCollection", true));
          // Match Visual Studio: the stream reader supplies no profile filename or base URI.
          using ((IDisposable)collection)
          using (var stream = File.OpenRead(ProfileFile))
          using (var reader = XmlReader.Create(stream))
          {
            var profile = Activator.CreateInstance(projectType, new object[] { reader, null, null, collection });
            var getPropertyValue = projectType.GetMethod("GetPropertyValue", new[] { typeof(string) });
            foreach (var property in new[] { "PublishDir", "PublishUrl" })
            {
              var value = (string)getPropertyValue.Invoke(profile, new object[] { property });
              var actual = Path.GetFullPath(Path.Combine(ApplicationProjectDirectory, value));
              if (String.IsNullOrWhiteSpace(value) || !String.Equals(actual, ExpectedPublishPath, StringComparison.Ordinal))
              {
                Log.LogError("{0}: Visual Studio's stream reader resolves {1} to {2}; expected {3}.", ProfileFile, property, actual, ExpectedPublishPath);
              }
            }
          }
        }
        catch (Exception exception)
        {
          Log.LogError("{0}: Visual Studio's stream reader failed: {1}", ProfileFile, exception.GetBaseException().Message);
        }
        return !Log.HasLoggedErrors;
      }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="VerifyPublishPaths">
    <ItemGroup>
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool/Properties/PublishProfiles/FolderProfile.pubxml" ApplicationProject="sip-testing-tool" Subdirectory="app" />
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool/Properties/PublishProfiles/Windows-SingleFile.pubxml" ApplicationProject="sip-testing-tool" Subdirectory="app-single-file" />
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool/Properties/PublishProfiles/ClickOnceProfile.pubxml" ApplicationProject="sip-testing-tool" Subdirectory="clickonce" />
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool-avalonia/Properties/PublishProfiles/Velopack-Windows.pubxml" ApplicationProject="sip-testing-tool-avalonia" Subdirectory="avalonia/publish/win-x64" />
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool-avalonia/Properties/PublishProfiles/Velopack-Linux.pubxml" ApplicationProject="sip-testing-tool-avalonia" Subdirectory="avalonia/publish/linux-x64" />
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool-avalonia/Properties/PublishProfiles/Windows-SingleFile.pubxml" ApplicationProject="sip-testing-tool-avalonia" Subdirectory="avalonia/publish/win-x64-single-file" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="VerifyProfile" Properties="ProfileFile=%(ProfileCheck.Identity);ApplicationProject=%(ProfileCheck.ApplicationProject);ExpectedSubdirectory=%(ProfileCheck.Subdirectory)" />
  </Target>

  <Target Name="VerifyProfile" DependsOnTargets="ResolveVelopackPublishPaths">
    <PropertyGroup>
      <ApplicationProjectDirectory>$(RepositoryDirectory)src/$(ApplicationProject)/</ApplicationProjectDirectory>
      <ExpectedPublishPath>$([System.IO.Path]::GetFullPath('$(RepositoryDirectory)artifacts/$(ExpectedSubdirectory)/'))</ExpectedPublishPath>
      <ActualPublishPath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(ApplicationProjectDirectory)', '$(PublishDir)'))))</ActualPublishPath>
      <ActualPublishUrl Condition="'$(PublishUrl)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(ApplicationProjectDirectory)', '$(PublishUrl)'))))</ActualPublishUrl>
      <ExpectedVelopackPath>$([System.IO.Path]::GetFullPath('$(RepositoryDirectory)artifacts/velopack/$(RuntimeIdentifier)'))</ExpectedVelopackPath>
    </PropertyGroup>
    <Error Condition="'$(ActualPublishPath)' != '$(ExpectedPublishPath)'" Text="$(ProfileFile): PublishDir resolves to $(ActualPublishPath); expected $(ExpectedPublishPath)." />
    <Error Condition="'$(ActualPublishUrl)' != '$(ExpectedPublishPath)'" Text="$(ProfileFile): PublishUrl resolves to $(ActualPublishUrl); expected $(ExpectedPublishPath)." />
    <Error Condition="'$(CreateVelopackPackage)' == 'true' and '$(VelopackOutputDir)' != '$(ExpectedVelopackPath)'" Text="$(ProfileFile): VelopackOutputDir resolves to $(VelopackOutputDir); expected $(ExpectedVelopackPath)." />
    <VerifyPublishProfileStream ProfileFile="$(ProfileFile)" ApplicationProjectDirectory="$(ApplicationProjectDirectory)" ExpectedPublishPath="$(ExpectedPublishPath)" />
    <Message Importance="high" Text="$([System.IO.Path]::GetFileName('$(ProfileFile)')): $(ActualPublishPath)" />
  </Target>
</Project>
