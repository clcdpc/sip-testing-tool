<Project DefaultTargets="VerifyPublishPaths">
  <PropertyGroup>
    <PublishPathsFile>$([MSBuild]::GetPathOfFileAbove('PublishPaths.props', '$(MSBuildThisFileDirectory)'))</PublishPathsFile>
    <RepositoryDirectory>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetDirectoryName('$(PublishPathsFile)'))))</RepositoryDirectory>
  </PropertyGroup>
  <!-- Let each profile load its own path properties, as an independent publishing helper would. -->
  <Import Project="$(ProfileFile)" Condition="'$(ProfileFile)' != ''" />
  <Import Project="$(RepositoryDirectory)src/sip-testing-tool-avalonia/Properties/Release.targets" Condition="'$(ProfileFile)' != ''" />

  <UsingTask TaskName="VerifyPublishProfileStream" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ProfileFile ParameterType="System.String" Required="true" />
      <ApplicationProjectDirectory ParameterType="System.String" Required="true" />
      <ExpectedPublishPath ParameterType="System.String" Required="true" />
      <PublishDirectoryOverride ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Xml" />
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Method" Language="cs"><![CDATA[
      public override bool Execute()
      {
        try
        {
          // Use the running MSBuild assembly with either the .NET or Visual Studio host.
          var projectType = Type.GetType("Microsoft.Build.Evaluation.Project, Microsoft.Build", true);
          var collection = Activator.CreateInstance(projectType.Assembly.GetType("Microsoft.Build.Evaluation.ProjectCollection", true));
          // Match Visual Studio: the stream reader supplies no profile filename or base URI.
          using ((IDisposable)collection)
          using (var stream = File.OpenRead(ProfileFile))
          using (var reader = XmlReader.Create(stream))
          {
            var globals = new Dictionary<string, string>();
            if (!String.IsNullOrEmpty(PublishDirectoryOverride))
              globals["PublishDir"] = PublishDirectoryOverride;
            var profile = Activator.CreateInstance(projectType, new object[] { reader, globals, null, collection });
            var getPropertyValue = projectType.GetMethod("GetPropertyValue", new[] { typeof(string) });
            foreach (var property in new[] { "PublishDir", "PublishUrl" })
            {
              var value = (string)getPropertyValue.Invoke(profile, new object[] { property });
              var actual = Path.GetFullPath(Path.Combine(ApplicationProjectDirectory, value));
              if (String.IsNullOrWhiteSpace(value) || !String.Equals(actual, ExpectedPublishPath, StringComparison.Ordinal))
              {
                Log.LogError("{0}: Visual Studio's stream reader resolves {1} to {2}; expected {3}.", ProfileFile, property, actual, ExpectedPublishPath);
              }
            }
          }
        }
        catch (Exception exception)
        {
          Log.LogError("{0}: Visual Studio's stream reader failed: {1}", ProfileFile, exception.GetBaseException().Message);
        }
        return !Log.HasLoggedErrors;
      }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="VerifyPublishPaths">
    <ItemGroup>
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool/Properties/PublishProfiles/FolderProfile.pubxml" ApplicationProject="sip-testing-tool" Subdirectory="app" />
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool/Properties/PublishProfiles/Windows-SingleFile.pubxml" ApplicationProject="sip-testing-tool" Subdirectory="app-single-file" />
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool/Properties/PublishProfiles/ClickOnceProfile.pubxml" ApplicationProject="sip-testing-tool" Subdirectory="clickonce" />
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool-avalonia/Properties/PublishProfiles/Windows-Zip.pubxml" ApplicationProject="sip-testing-tool-avalonia" Subdirectory="avalonia/releases/win-x64" />
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool-avalonia/Properties/PublishProfiles/Linux-AppImage.pubxml" ApplicationProject="sip-testing-tool-avalonia" Subdirectory="avalonia/releases/linux-x64" />
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool-avalonia/Properties/PublishProfiles/Windows-SingleFile.pubxml" ApplicationProject="sip-testing-tool-avalonia" Subdirectory="avalonia/publish/win-x64-single-file" />
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool-avalonia/Properties/PublishProfiles/macOS-arm64.pubxml" ApplicationProject="sip-testing-tool-avalonia" Subdirectory="avalonia/publish/osx-arm64" />
      <ProfileCheck Include="$(RepositoryDirectory)src/sip-testing-tool-avalonia/Properties/PublishProfiles/macOS-x64.pubxml" ApplicationProject="sip-testing-tool-avalonia" Subdirectory="avalonia/publish/osx-x64" />
      <ReleaseProfileCheck Include="@(ProfileCheck)" Condition="'%(ProfileCheck.Subdirectory)' == 'avalonia/releases/win-x64' or '%(ProfileCheck.Subdirectory)' == 'avalonia/releases/linux-x64'" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="VerifyProfile;VerifyReleaseStaging" Properties="ProfileFile=%(ProfileCheck.Identity);ApplicationProject=%(ProfileCheck.ApplicationProject);ExpectedSubdirectory=%(ProfileCheck.Subdirectory)" />
    <!-- Visual Studio passes the selected destination as a global property. It must still
         redirect to staging, including when the user chooses a folder containing spaces. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="VerifyProfile;VerifyReleaseStaging" Properties="ProfileFile=%(ReleaseProfileCheck.Identity);ApplicationProject=%(ReleaseProfileCheck.ApplicationProject);ExpectedSubdirectory=custom release/%(ReleaseProfileCheck.Subdirectory);PublishDir=../../artifacts/custom release/%(ReleaseProfileCheck.Subdirectory)/;PublishUrl=../../artifacts/custom release/%(ReleaseProfileCheck.Subdirectory)/;ProfilePublishDirectoryOverride=../../artifacts/custom release/%(ReleaseProfileCheck.Subdirectory)/" />
  </Target>

  <Target Name="VerifyProfile" DependsOnTargets="ResolveReleasePublishPaths">
    <PropertyGroup>
      <ApplicationProjectDirectory>$(RepositoryDirectory)src/$(ApplicationProject)/</ApplicationProjectDirectory>
      <ExpectedPublishPath>$([System.IO.Path]::GetFullPath('$(RepositoryDirectory)artifacts/$(ExpectedSubdirectory)/'))</ExpectedPublishPath>
      <ActualPublishPath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(ApplicationProjectDirectory)', '$(PublishDir)'))))</ActualPublishPath>
      <ActualPublishUrl Condition="'$(PublishUrl)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(ApplicationProjectDirectory)', '$(PublishUrl)'))))</ActualPublishUrl>
      <ActualReleasePath Condition="'$(CreateDesktopPackage)' == 'true'">$([MSBuild]::NormalizeDirectory('$(ApplicationProjectDirectory)', '$(ReleaseOutputDir)'))</ActualReleasePath>
    </PropertyGroup>
    <Error Condition="'$(ActualPublishPath)' != '$(ExpectedPublishPath)'" Text="$(ProfileFile): PublishDir resolves to $(ActualPublishPath); expected $(ExpectedPublishPath)." />
    <Error Condition="'$(ActualPublishUrl)' != '$(ExpectedPublishPath)'" Text="$(ProfileFile): PublishUrl resolves to $(ActualPublishUrl); expected $(ExpectedPublishPath)." />
    <Error Condition="'$(CreateDesktopPackage)' == 'true' and '$(ActualReleasePath)' != '$(ExpectedPublishPath)'" Text="$(ProfileFile): ReleaseOutputDir resolves to $(ActualReleasePath); expected $(ExpectedPublishPath)." />
    <VerifyPublishProfileStream ProfileFile="$(ProfileFile)" ApplicationProjectDirectory="$(ApplicationProjectDirectory)" ExpectedPublishPath="$(ExpectedPublishPath)" PublishDirectoryOverride="$(ProfilePublishDirectoryOverride)" />
    <Message Importance="high" Text="$([System.IO.Path]::GetFileName('$(ProfileFile)')): $(ActualPublishPath)" />
  </Target>

  <Target Name="VerifyReleaseStaging" DependsOnTargets="StageDesktopPublish" Condition="'$(CreateDesktopPackage)' == 'true'">
    <PropertyGroup>
      <ExpectedStagingPath>$([MSBuild]::NormalizeDirectory('$(RepositoryDirectory)', 'artifacts/avalonia/staging/$(RuntimeIdentifier)'))</ExpectedStagingPath>
      <StagedPublishUrl>$([MSBuild]::NormalizeDirectory('$(ApplicationProjectDirectory)', '$(PublishUrl)'))</StagedPublishUrl>
      <StagedReleaseOutputDir>$([MSBuild]::NormalizeDirectory('$(ApplicationProjectDirectory)', '$(ReleaseOutputDir)'))</StagedReleaseOutputDir>
    </PropertyGroup>
    <Error Condition="'$(PublishDir)' != '$(ExpectedStagingPath)'" Text="$(ProfileFile): .NET must publish to staging, including when PublishDir is a global property." />
    <Error Condition="'$(StagedReleaseOutputDir)' != '$(ExpectedPublishPath)' or '$(StagedPublishUrl)' != '$(ExpectedPublishPath)'" Text="$(ProfileFile): staging must preserve the release destination shown in Visual Studio." />
  </Target>
</Project>
