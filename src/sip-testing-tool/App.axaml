<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Clc.Sip.Desktop.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <StreamGeometry x:Key="DropDownChevron">M 0,0 L 4,4 L 8,0 L 9,1 L 4,6 L -1,1 Z</StreamGeometry>
      <StreamGeometry x:Key="ClockIcon">F0 M 8,0 A 8,8 0 1 1 8,16 A 8,8 0 1 1 8,0 Z M 8,1.5 A 6.5,6.5 0 1 0 8,14.5 A 6.5,6.5 0 1 0 8,1.5 Z M 7.25,3.5 L 8.75,3.5 L 8.75,7.5 L 11.5,9.1 L 10.75,10.4 L 7.25,8.4 Z</StreamGeometry>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="RibbonBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="LogBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="InspectorGroupBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="LineBrush" Color="#D6D6D6" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#FFF0F0" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#A62929" />
          <SolidColorBrush x:Key="InspectorSetBrush" Color="#22633B" />
          <SolidColorBrush x:Key="InspectorInvalidBrush" Color="#8B4B0E" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="RibbonBrush" Color="#1E2024" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2024" />
          <SolidColorBrush x:Key="LogBrush" Color="#17191D" />
          <SolidColorBrush x:Key="InputBrush" Color="#2F333A" />
          <SolidColorBrush x:Key="InspectorGroupBrush" Color="#26292E" />
          <SolidColorBrush x:Key="LineBrush" Color="#474E59" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#452C2C" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFB5B5" />
          <SolidColorBrush x:Key="InspectorSetBrush" Color="#80D6A0" />
          <SolidColorBrush x:Key="InspectorInvalidBrush" Color="#FFBC68" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <Style Selector="Window"><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="Menu &gt; MenuItem"><Setter Property="MinHeight" Value="24" /><Setter Property="Padding" Value="8,3" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="26" /><Setter Property="Padding" Value="6,2" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="TextBox"><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="Background" Value="{DynamicResource InputBrush}" /></Style>
    <Style Selector="ListBox.messageFields &gt; ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="26" /><Setter Property="Padding" Value="6,2" /><Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="AutoCompleteBox"><Setter Property="MinHeight" Value="26" /><Setter Property="Padding" Value="6,2" /><Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /></Style>
    <Style Selector="CheckBox"><Setter Property="MinHeight" Value="20" /><Setter Property="Padding" Value="6,0,0,0" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="29" /><Setter Property="Padding" Value="10,3" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="TimePickerPresenter /template/ DateTimePickerPanel[PanelType=Hour]"><Setter Property="AutomationProperties.Name" Value="Hours" /></Style>
    <Style Selector="TimePickerPresenter /template/ DateTimePickerPanel[PanelType=Minute]"><Setter Property="AutomationProperties.Name" Value="Minutes" /></Style>
    <Style Selector="TimePickerPresenter /template/ DateTimePickerPanel[PanelType=Second]"><Setter Property="AutomationProperties.Name" Value="Seconds" /></Style>
    <Style Selector="TimePickerPresenter /template/ Button#PART_AcceptButton"><Setter Property="AutomationProperties.Name" Value="Apply time" /></Style>
    <Style Selector="TimePickerPresenter /template/ Button#PART_DismissButton"><Setter Property="AutomationProperties.Name" Value="Cancel time" /></Style>
    <Style Selector="TextBlock.groupTitle"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
    <Style Selector="TextBlock.fieldLabel"><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
    <Style Selector="StackPanel.field"><Setter Property="Spacing" Value="0" /></Style>
    <Style Selector="TextBlock.hint"><Setter Property="Opacity" Value="0.72" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  </Application.Styles>
</Application>
