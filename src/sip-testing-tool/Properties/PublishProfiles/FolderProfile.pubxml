<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- Visual Studio reads profiles without a file path; keep this relative to the app project. -->
    <PublishDir>../../artifacts/app/</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
