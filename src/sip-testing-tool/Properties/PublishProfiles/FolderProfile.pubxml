<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('PublishPaths.props', '$(MSBuildThisFileDirectory)'))" Condition="'$(SipRepositoryDirectory)' == ''" />
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>$([System.IO.Path]::GetFullPath('$(SipArtifactsDirectory)app/'))</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
