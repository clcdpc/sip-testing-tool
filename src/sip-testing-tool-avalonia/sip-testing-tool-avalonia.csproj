<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Clc.Sip.Desktop</RootNamespace>
    <AssemblyName>sip-testing-tool-avalonia</AssemblyName>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Version>3.0.0-beta.4</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="StageKit.Updatum" Version="0.4.1" />
    <InternalsVisibleTo Include="sip-desktop-tests" />
    <ProjectReference Include="../sip-core/sip-core.csproj" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <Import Project="Properties/Release.targets" />
</Project>
