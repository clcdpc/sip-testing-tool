<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Clc.Sip.Desktop.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="RibbonBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="LineBrush" Color="#D6D6D6" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#FFF0F0" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#A62929" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="RibbonBrush" Color="#202020" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#292929" />
          <SolidColorBrush x:Key="LineBrush" Color="#454545" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#452C2C" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFB5B5" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <Style Selector="Window"><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="7,4" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="7,3" /></Style>
    <Style Selector="AutoCompleteBox"><Setter Property="MinHeight" Value="30" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="12,4" /></Style>
    <Style Selector="TextBlock.groupTitle"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
    <Style Selector="TextBlock.fieldLabel"><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
    <Style Selector="StackPanel.field"><Setter Property="Spacing" Value="0" /></Style>
    <Style Selector="TextBlock.hint"><Setter Property="Opacity" Value="0.72" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  </Application.Styles>
</Application>
