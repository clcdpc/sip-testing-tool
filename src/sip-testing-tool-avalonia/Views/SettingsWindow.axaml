<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Clc.Sip.Desktop.Models"
        x:Class="Clc.Sip.Desktop.Views.SettingsWindow" x:DataType="models:AppPreferences"
        Title="Default settings" Width="940" Height="640" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="22">
    <TextBlock Text="Default settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <Grid ColumnDefinitions="*,28,*">
        <StackPanel Spacing="12">
          <TextBlock Classes="groupTitle" Text="Connection and login" />
          <Grid ColumnDefinitions="*,82">
            <StackPanel Classes="field" Margin="0,0,10,0"><TextBlock Classes="fieldLabel" Text="Server" /><TextBox Text="{Binding Defaults.Server}" /></StackPanel>
            <StackPanel Grid.Column="1" Classes="field"><TextBlock Classes="fieldLabel" Text="Port" /><TextBox Text="{Binding Defaults.Port}" /></StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*">
            <StackPanel Classes="field" Margin="0,0,10,0"><TextBlock Classes="fieldLabel" Text="Institution (AO)" /><TextBox Text="{Binding Defaults.Ao}" /></StackPanel>
            <StackPanel Grid.Column="1" Classes="field"><TextBlock Classes="fieldLabel" Text="Terminal (AP)" /><TextBox Text="{Binding Defaults.Ap}" /></StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*">
            <StackPanel Classes="field" Margin="0,0,10,0"><TextBlock Classes="fieldLabel" Text="Username" /><TextBox Text="{Binding Defaults.Username}" /></StackPanel>
            <StackPanel Grid.Column="1" Classes="field"><TextBlock Classes="fieldLabel" Text="Password" /><TextBox Text="{Binding Defaults.Password}" PasswordChar="●" /></StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*">
            <StackPanel Classes="field" Margin="0,0,10,0"><TextBlock Classes="fieldLabel" Text="Location code (CP)" /><TextBox Text="{Binding Defaults.LocationCode}" /></StackPanel>
            <StackPanel Grid.Column="1" Classes="field"><TextBlock Classes="fieldLabel" Text="Vendor profile (VP)" /><TextBox Text="{Binding Defaults.VendorProfile}" /></StackPanel>
          </Grid>
          <CheckBox Content="Connect on startup" IsChecked="{Binding ConnectOnStartup}" />
          <CheckBox Content="Dark theme" IsChecked="{Binding DarkTheme}" />
          <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="Character encoding" /><TextBox Text="{Binding EncodingName}" PlaceholderText="UTF-8" /></StackPanel>
          <CheckBox Content="Validate response checksums" IsChecked="{Binding ValidateChecksums}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="12">
          <TextBlock Classes="groupTitle" Text="Patron and item" />
          <Grid ColumnDefinitions="*,100">
            <StackPanel Classes="field" Margin="0,0,10,0"><TextBlock Classes="fieldLabel" Text="Patron barcode" /><TextBox Text="{Binding Defaults.PatronBarcode}" /></StackPanel>
            <StackPanel Grid.Column="1" Classes="field"><TextBlock Classes="fieldLabel" Text="Patron PIN" /><TextBox Text="{Binding Defaults.PatronPin}" PasswordChar="●" /></StackPanel>
          </Grid>
          <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="Item barcode" /><TextBox Text="{Binding Defaults.ItemBarcode}" /></StackPanel>
          <Separator Margin="0,8" />
          <TextBlock Classes="groupTitle" Text="Application updates" />
          <StackPanel Classes="field"><TextBlock Classes="fieldLabel" Text="Update feed base URL" /><TextBox Text="{Binding UpdateFeedUrl}" PlaceholderText="https://…/updates/desktop/" /></StackPanel>
          <CheckBox Content="Check and download updates on startup" IsChecked="{Binding CheckUpdatesOnStartup}" />
          <TextBlock Classes="hint" Text="Downloaded updates are installed when you choose Restart to update." />
          <TextBlock x:Name="SettingsError" TextWrapping="Wrap" Foreground="{DynamicResource ErrorTextBrush}" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,18,0,0">
      <Button Content="Cancel" Click="Cancel_Click" />
      <Button Content="Save defaults" Classes="accent" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
