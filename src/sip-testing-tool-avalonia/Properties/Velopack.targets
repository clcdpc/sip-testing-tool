<Project>
  <PropertyGroup>
    <VelopackPackId>Clc.SipTestingTool.Desktop</VelopackPackId>
  </PropertyGroup>

  <Target Name="PackageWithVelopack" AfterTargets="Publish" Condition="'$(CreateVelopackPackage)' == 'true'">
    <Error Condition="'$(Configuration)' != 'Release'" Text="Velopack releases must use the Release configuration." />
    <Error Condition="'$(RuntimeIdentifier)' != 'win-x64' and '$(RuntimeIdentifier)' != 'linux-x64'" Text="Choose the Velopack-Windows or Velopack-Linux publish profile." />
    <PropertyGroup>
      <VelopackOutputDir Condition="'$(VelopackOutputDir)' == ''">$(MSBuildProjectDirectory)/../../artifacts/velopack/$(RuntimeIdentifier)</VelopackOutputDir>
      <VelopackPlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'">win</VelopackPlatform>
      <VelopackPlatform Condition="'$(RuntimeIdentifier)' == 'linux-x64'">linux</VelopackPlatform>
      <VelopackMainExe>$(AssemblyName)</VelopackMainExe>
      <VelopackMainExe Condition="'$(VelopackPlatform)' == 'win'">$(AssemblyName).exe</VelopackMainExe>
      <VelopackIcon>$(MSBuildProjectDirectory)/Assets/app.png</VelopackIcon>
      <VelopackIcon Condition="'$(VelopackPlatform)' == 'win'">$(MSBuildProjectDirectory)/Assets/app.ico</VelopackIcon>
      <VelopackSigningArguments Condition="'$(VelopackPlatform)' == 'win' and '$(VelopackSignParams)' != ''">--signParams &quot;$(VelopackSignParams)&quot;</VelopackSigningArguments>
    </PropertyGroup>
    <Message Importance="high" Text="Creating $(RuntimeIdentifier) Velopack release $(Version)." />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="dotnet tool restore --tool-manifest &quot;$(MSBuildProjectDirectory)/.config/dotnet-tools.json&quot;" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="dotnet tool run vpk -- [$(VelopackPlatform)] pack --packId $(VelopackPackId) --packVersion $(Version) --packDir &quot;$(PublishDir).&quot; --runtime $(RuntimeIdentifier) --mainExe &quot;$(VelopackMainExe)&quot; --icon &quot;$(VelopackIcon)&quot; --packTitle &quot;SIP Testing Tool Desktop&quot; --packAuthors &quot;Central Library Consortium&quot; --outputDir &quot;$(VelopackOutputDir)&quot; $(VelopackSigningArguments)" />
    <Message Importance="high" Text="Velopack release files: $(VelopackOutputDir)" />
  </Target>
</Project>
