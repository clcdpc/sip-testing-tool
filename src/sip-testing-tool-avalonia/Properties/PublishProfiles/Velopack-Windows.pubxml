<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('PublishPaths.props', '$(MSBuildThisFileDirectory)'))" Condition="'$(SipRepositoryDirectory)' == ''" />
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$([System.IO.Path]::GetFullPath('$(SipArtifactsDirectory)avalonia/publish/win-x64/'))</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
    <CreateVelopackPackage>true</CreateVelopackPackage>
  </PropertyGroup>
</Project>
