<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Visual Studio reads profiles without a file path; keep this relative to the app project. -->
    <PublishDir>../../artifacts/avalonia/publish/win-x64/</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
    <CreateVelopackPackage>true</CreateVelopackPackage>
  </PropertyGroup>
</Project>
